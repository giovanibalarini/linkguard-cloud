{
  "title": "LinkGuard Cloud",
  "schemaVersion": 39,
  "panels": [
    {
      "title": "System resources",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "linkguard_system_cpu_percent",
          "legendFormat": "CPU %"
        },
        {
          "expr": "linkguard_system_memory_percent",
          "legendFormat": "Mem %"
        },
        {
          "expr": "linkguard_system_disk_percent",
          "legendFormat": "Disk %"
        }
      ]
    },
    {
      "title": "Unresolved alerts",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "linkguard_alerts_unresolved_total"
        }
      ]
    }
  ]
}
